# ==============================================================================
# Vidyashilp University AI Academic Advisor — Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE / POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Direct database connection string (used for schema migrations and direct scripts)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# OPENAI / COMPATIBLE LLM & EMBEDDING APIS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Models
LLM_COMPLETION_MODEL=gpt-4o-mini
LLM_REASONING_MODEL=gpt-4o
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# RETRIEVAL & GUARDRAILS CONFIGURATION
# ------------------------------------------------------------------------------
RAG_SIMILARITY_THRESHOLD=0.68
RAG_TOP_K=5
ENABLE_STRICT_SOURCE_HIERARCHY=true

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
